{
  "editor.formatOnSave": true,
  "editor.rulers": [80],
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "dart.lineLength": 80,
  "dart.previewFlutterUiGuides": true,
  "dart.showTodos": false,
  "search.exclude": {
    "**/*.g.dart": true,
    "**/*.freezed.dart": true,
    "**/.dart_tool": true,
    "**/build": true
  },
  "files.watcherExclude": {
    "**/.dart_tool/**": true,
    "**/build/**": true
  }
}
