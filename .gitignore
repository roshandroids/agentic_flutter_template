# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/
pubspec.lock
!/pubspec.lock
pubspec_overrides.yaml
*.g.dart.bak

# Flutter
.flutter-plugins
.flutter-plugins-dependencies
.flutter-versions
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/android/.gradle/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
